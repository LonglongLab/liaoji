# This context is generated by packaging/server/prepare_context.py. No repo COPY.
FROM ghcr.io/astral-sh/uv:0.11.31@sha256:812f4717f0002c1c5400653454de9a29b7cbe93bdfe19451376d6aaac522a9bf AS uv

FROM python:3.12.11-slim-bookworm@sha256:c00fc7b44d844b6da22861ec24af43968a5200eac4ec607b4725d585165d6b49 AS build
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project --no-cache
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable --no-cache

FROM python:3.12.11-slim-bookworm@sha256:c00fc7b44d844b6da22861ec24af43968a5200eac4ec607b4725d585165d6b49 AS runtime
RUN groupadd --system --gid 10001 chatarchive \
    && useradd --system --uid 10001 --gid chatarchive --home-dir /nonexistent chatarchive
WORKDIR /app
COPY --from=build --chown=10001:10001 /app/.venv /app/.venv
COPY --chown=10001:10001 frontend-dist /app/frontend-dist
COPY --chown=10001:10001 release.json /app/release.json
ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CHAT_ARCHIVE_FRONTEND_DIST=/app/frontend-dist
USER 10001:10001
EXPOSE 8080
CMD ["uvicorn", "--factory", "chat_archive.server.runtime:create_runtime_app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--no-proxy-headers"]

FROM alpine:3.22.1@sha256:eafc1edb577d2e9b458664a15f23ea1c370214193226069eb22921169fc7e43f AS data-init
COPY initialize-api-data.sh /usr/local/bin/initialize-api-data
RUN chmod 0555 /usr/local/bin/initialize-api-data
ENTRYPOINT ["/usr/local/bin/initialize-api-data"]
